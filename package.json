{
  "name": "ningaui",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A small browser agent for API work, with autonomy it has to earn.",
  "license": "MIT",
  "keywords": [
    "agent",
    "llm",
    "browser-extension",
    "manifest-v3",
    "chrome",
    "firefox",
    "human-in-the-loop",
    "approval",
    "autonomy",
    "policy"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "python3 build.py",
    "mascot": "python3 assets/mascot.py",
    "test": "python3 build.py && node test/loop.test.mjs && node test/actions.test.mjs && node test/policy.test.mjs && node test/crossbrowser.test.mjs",
    "test:loop": "node test/loop.test.mjs",
    "test:actions": "node test/actions.test.mjs",
    "test:policy": "node test/policy.test.mjs",
    "test:crossbrowser": "python3 build.py && node test/crossbrowser.test.mjs"
  }
}
